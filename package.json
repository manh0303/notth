{
  "name": "@manhd_d/notth",
  "version": "0.18.0",
  "description": "Reusable AI development rules, skills and workflows with a safe local installer",
  "type": "module",
  "bin": {
    "aih": "bin/aih.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manh0303/notth.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "bin/",
    "cli/*.js",
    "config/",
    "core/",
    "adapters/",
    "capabilities/",
    "integrations/",
    "templates/",
    "harness.yaml",
    "docs/",
    "evals/",
    "scripts/score-eval.js",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "scripts/compare-tasks.js",
    "scripts/conformance-runner.js"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate.js",
    "test:package": "node scripts/smoke-package.js",
    "prepublishOnly": "npm test && npm run validate && npm run check:release && npm run test:package",
    "check:release": "node scripts/check-release.js",
    "build:python": "python scripts/build-python.py",
    "test:python": "python scripts/smoke-python.py",
    "eval:conformance": "node scripts/conformance-runner.js"
  }
}
